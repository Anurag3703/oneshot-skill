#!/usr/bin/env bash
# bti-skill: BMW TechWorks India Copilot Skill Manager
# Usage:
#   bti-skill install [skill-name]
#   bti-skill list
#   bti-skill update
#   bti-skill remove [skill-name]
#   bti-skill oneshot (shortcut to install oneshot / contextual-prompt-generator)
set -euo pipefail

HOST="${GH_HOST:-bmw.ghe.com}"
ORG_OR_USER="${BTI_SKILL_ORG:-CDBase}"
COPILOT_SKILLS_DIR="$HOME/.copilot/skills"
GITHUB_SKILLS_DIR="$HOME/.github/skills"

show_help() {
  cat << EOF
BMW TechWorks India (BTI) - Copilot Skill Manager

Usage:
  bti-skill install <name>    Install a skill (e.g., oneshot, contextual-prompt-generator)
  bti-skill list              List installed and available BTI skills
  bti-skill update            Update installed skills to latest
  bti-skill remove <name>     Remove an installed skill
  bti-skill help              Show this help message

Aliases:
  bti-skill oneshot           Quick-install contextual-prompt-generator (One-Shot)
EOF
}

install_skill() {
  local target="${1:-contextual-prompt-generator}"

  # Alias mappings
  case "$target" in
    oneshot|one-shot|prompt|prompt-gen)
      target="contextual-prompt-generator"
      ;;
  esac

  echo "==> [BTI-Skill] Installing '$target' from $HOST/$ORG_OR_USER …"

  TMP="$(mktemp -d)"
  cleanup() { rm -rf "$TMP"; }
  trap cleanup EXIT

  DOWNLOAD_OK=0
  if command -v gh >/dev/null 2>&1; then
    if GH_HOST="$HOST" gh api "/repos/${ORG_OR_USER}/${target}/tarball/main" 2>/dev/null | tar -xz -C "$TMP" 2>/dev/null; then
      DOWNLOAD_OK=1
    fi
  fi

  if [[ $DOWNLOAD_OK -eq 0 ]]; then
    if curl -fsSL "https://${HOST}/${ORG_OR_USER}/${target}/archive/refs/heads/main.tar.gz" 2>/dev/null | tar -xz -C "$TMP" 2>/dev/null; then
      DOWNLOAD_OK=1
    fi
  fi

  if [[ $DOWNLOAD_OK -eq 0 ]]; then
    if git clone --depth 1 "https://${HOST}/${ORG_OR_USER}/${target}.git" "$TMP/repo" 2>/dev/null; then
      DOWNLOAD_OK=1
    fi
  fi

  if [[ $DOWNLOAD_OK -eq 0 ]]; then
    echo "❌ Error: Could not download '$target' from https://${HOST}/${ORG_OR_USER}/${target}."
    echo "   Please check repository access or authentication with: gh auth status"
    exit 1
  fi

  ROOT="$(find "$TMP" -mindepth 1 -maxdepth 1 -type d | head -1)"
  [[ -d "$TMP/repo" ]] && ROOT="$TMP/repo"

  if [[ -f "$ROOT/scripts/install.sh" ]]; then
    bash "$ROOT/scripts/install.sh" --global
  elif [[ -f "$ROOT/SKILL.md" ]]; then
    mkdir -p "$COPILOT_SKILLS_DIR/$target" "$GITHUB_SKILLS_DIR/$target"
    cp -R "$ROOT/"* "$COPILOT_SKILLS_DIR/$target/"
    cp -R "$ROOT/"* "$GITHUB_SKILLS_DIR/$target/"
    echo "✓ Installed $target into ~/.copilot/skills and ~/.github/skills"
  else
    echo "❌ Error: Valid SKILL.md not found in repository."
    exit 1
  fi

  echo
  echo "✅ [BTI-Skill] Successfully installed '$target'!"
  echo "👉 Start a new Copilot Chat session in VS Code to use it."
}

list_skills() {
  echo "==> Installed BTI Skills in Copilot:"
  if [[ -d "$COPILOT_SKILLS_DIR" ]]; then
    local count=0
    for dir in "$COPILOT_SKILLS_DIR"/*; do
      if [[ -d "$dir" && -f "$dir/SKILL.md" ]]; then
        echo "  • $(basename "$dir")"
        count=$((count + 1))
      fi
    done
    if [[ $count -eq 0 ]]; then
      echo "  (No skills currently installed)"
    fi
  else
    echo "  (No skills directory found)"
  fi
}

remove_skill() {
  local target="${1:-}"
  if [[ -z "$target" ]]; then
    echo "Usage: bti-skill remove <skill-name>"
    exit 1
  fi
  case "$target" in
    oneshot|one-shot|prompt|prompt-gen)
      target="contextual-prompt-generator"
      ;;
  esac
  rm -rf "$COPILOT_SKILLS_DIR/$target" "$GITHUB_SKILLS_DIR/$target" "$HOME/.grok/skills/$target"
  echo "🗑️ Removed '$target' from Copilot skills."
}

# CLI routing
CMD="${1:-help}"

case "$CMD" in
  install)
    shift
    install_skill "${1:-contextual-prompt-generator}"
    ;;
  oneshot|one-shot)
    install_skill "contextual-prompt-generator"
    ;;
  list|ls)
    list_skills
    ;;
  remove|rm|uninstall)
    shift
    remove_skill "${1:-}"
    ;;
  update|upgrade)
    echo "==> Updating installed skills..."
    if [[ -d "$COPILOT_SKILLS_DIR" ]]; then
      for dir in "$COPILOT_SKILLS_DIR"/*; do
        if [[ -d "$dir" && -f "$dir/SKILL.md" ]]; then
          install_skill "$(basename "$dir")"
        fi
      done
    fi
    ;;
  help|-h|--help)
    show_help
    ;;
  *)
    install_skill "$CMD"
    ;;
esac
